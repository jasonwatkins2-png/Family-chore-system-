<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Family Chore Point Card</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- MSAL (Microsoft Authentication Library) -->
  <script src="https://alcdn.msauth.net/browser/2.38.0/js/msal-browser.min.js"></script>

  <style>
    :root {
      --bg: #f5f5f7;
      --card-bg: #ffffff;
      --accent: #0071e3;
      --accent-soft: #e5f0ff;
      --danger: #d70015;
      --text-main: #1d1d1f;
      --text-muted: #6e6e73;
      --radius-lg: 18px;
      --radius-md: 12px;
      --shadow-soft: 0 18px 40px rgba(0, 0, 0, 0.06);
      --font-main: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text",
        "Segoe UI", sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: var(--font-main);
      background: radial-gradient(circle at top, #ffffff 0, #f5f5f7 38%, #ebedf0 100%);
      color: var(--text-main);
    }

    .app-shell {
      max-width: 1100px;
      margin: 24px auto 40px;
      padding: 0 16px;
    }

    header {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    h1 {
      font-size: 1.7rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      margin: 0;
    }

    .subtitle {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin: 0;
    }

    .card-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 18px;
      align-items: flex-start;
    }

    @media (max-width: 800px) {
      .card-grid {
        grid-template-columns: 1fr;
      }
    }

    .panel {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-soft);
      padding: 16px 18px 18px;
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .panel-title {
      font-size: 1.05rem;
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.7rem;
      background: #f2f2f7;
      color: var(--text-muted);
    }

    .pill-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #30d158;
    }

    .section-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--text-muted);
      margin: 8px 0 4px;
    }

    .family-row {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding-bottom: 4px;
      margin-bottom: 6px;
    }

    .member-card {
      min-width: 150px;
      padding: 10px 11px;
      border-radius: 16px;
      background: linear-gradient(145deg, #ffffff 0, #f5f5f7 42%, #e8ebf5 100%);
      border: 1px solid #e5e5ea;
      display: flex;
      flex-direction: column;
      gap: 2px;
      cursor: default;
    }

    .member-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .member-name {
      font-weight: 600;
      color: var(--text-main);
      font-size: 0.9rem;
    }

    .points-badge {
      padding: 1px 8px;
      border-radius: 999px;
      font-size: 0.7rem;
      background: var(--accent-soft);
      color: var(--accent);
      font-weight: 600;
    }

    .points-large {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-top: 2px;
    }

    .small-text {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .list {
      margin: 8px 0 0;
      padding: 0;
      list-style: none;
      max-height: 210px;
      overflow-y: auto;
    }

    .list-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 7px 0;
      border-bottom: 1px solid #eeeef0;
      font-size: 0.85rem;
    }

    .list-main {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .pill-small {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 7px;
      border-radius: 999px;
      font-size: 0.7rem;
      background: #f5f5f7;
      color: var(--text-muted);
    }

    .history {
      max-height: 200px;
      overflow-y: auto;
      font-size: 0.78rem;
      border-radius: var(--radius-md);
      background: #f8f8fb;
      padding: 8px 10px;
      margin-top: 4px;
    }

    .history-entry {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      padding: 4px 0;
      border-bottom: 1px solid #e5e5ea;
    }

    .history-entry:last-child {
      border-bottom: none;
    }

    .tag-positive {
      color: #0b8a00;
      font-weight: 600;
    }

    .tag-negative {
      color: var(--danger);
      font-weight: 600;
    }

    .tag-member {
      font-weight: 600;
    }

    .footer {
      margin-top: 16px;
      font-size: 0.7rem;
      color: var(--text-muted);
      text-align: center;
    }

    .form-inline-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin: 8px 0 4px;
    }

    select,
    input[type="text"],
    input[type="number"] {
      border-radius: 999px;
      border: 1px solid #d2d2d7;
      padding: 6px 10px;
      font-size: 0.8rem;
      font-family: inherit;
      background: #fbfbfd;
      min-width: 0;
    }

    select:focus,
    input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px rgba(0, 113, 227, 0.16);
    }

    .btn {
      border-radius: 999px;
      border: none;
      background: var(--accent);
      color: white;
      font-size: 0.8rem;
      padding: 7px 14px;
      font-family: inherit;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 10px 20px rgba(0, 113, 227, 0.18);
      white-space: nowrap;
    }

    .btn-secondary {
      background: #f2f2f7;
      color: var(--text-main);
      box-shadow: none;
    }

    .btn-danger {
      background: var(--danger);
      box-shadow: 0 10px 20px rgba(215, 0, 21, 0.18);
    }

    .btn:active {
      transform: translateY(1px);
      box-shadow: none;
    }

    /* Login / role overlay */

    .login-overlay {
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at top, #ffffff 0, #f2f2f7 45%, #dcdcde 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }

    .login-card {
      background: #ffffff;
      border-radius: 22px;
      box-shadow: 0 22px 45px rgba(0, 0, 0, 0.12);
      padding: 20px 22px 18px;
      max-width: 360px;
      width: 90%;
    }

    .login-title {
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 8px;
      letter-spacing: -0.02em;
    }

    .user-list {
      margin: 10px 0 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .user-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 10px;
      border-radius: 12px;
      background: #f5f5f7;
      cursor: pointer;
    }

    .user-role {
      font-size: 0.7rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .login-error {
      color: var(--danger);
      font-size: 0.75rem;
      margin-top: 6px;
      min-height: 14px;
    }

    .current-user-chip {
      font-size: 0.78rem;
      background: #f2f2f7;
      padding: 4px 9px;
      border-radius: 999px;
    }

    .current-user-name {
      font-weight: 600;
    }

    .ms-login-btn {
      width: 100%;
      justify-content: center;
      margin-top: 12px;
    }

    .ms-user-info {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 8px;
    }
  </style>
</head>
<body>
  <!-- Login & Role overlay -->
  <div class="login-overlay" id="loginOverlay">
    <div class="login-card">
      <div class="login-title">Sign in with Microsoft</div>
      <p class="small-text">
        Sign in with your shared family Microsoft account. Then choose who is using it:
        Adult, Connor, Jonathan, or Jason.
      </p>

      <button class="btn ms-login-btn" id="msLoginBtn">Sign in with Microsoft</button>
      <div class="ms-user-info" id="msUserInfo"></div>

      <div class="section-label" style="margin-top: 14px;">Who is using it?</div>
      <ul class="user-list" id="roleList">
        <!-- Roles rendered here -->
      </ul>

      <div class="login-error" id="loginError"></div>
    </div>
  </div>

  <!-- Main app -->
  <div class="app-shell" style="display:none;" id="appShell">
    <header>
      <div>
        <h1>Family Chore Point Card</h1>
        <p class="subtitle">
          Apple-style family system with OneDrive sync. Adult sees all. Kids see only their own points.
        </p>
      </div>
      <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
        <div class="pill">
          <span class="pill-dot"></span>
          Synced to OneDrive · Shared family account
        </div>
        <div class="current-user-chip" id="currentUserChip"></div>
      </div>
    </header>

    <div class="card-grid">
      <!-- LEFT: Members + Chores -->
      <section class="panel">
        <div class="panel-header">
          <div class="panel-title">Point cards</div>
          <div class="small-text" id="totalPointsLabel"></div>
        </div>

        <div class="section-label">Members</div>
        <div class="family-row" id="membersContainer">
          <!-- Member cards -->
        </div>

        <hr style="border: none; border-top: 1px solid #e5e5ea; margin: 10px 0 8px" />

        <div class="panel-header">
          <div class="panel-title">Chores</div>
          <span class="small-text">Tap “Assign” to award points</span>
        </div>

        <div class="form-inline-row">
          <input
            type="text"
            id="newChoreName"
            placeholder="Chore name (e.g., Dishes)"
          />
          <input
            type="number"
            id="newChorePoints"
            placeholder="Points"
            min="1"
            style="max-width: 90px"
          />
          <button class="btn-secondary btn" id="addChoreBtn">
            <span>＋</span> Add chore
          </button>
        </div>

        <ul class="list" id="choreList"></ul>
      </section>

      <!-- RIGHT: Rewards + History -->
      <section class="panel">
        <div class="panel-header">
          <div class="panel-title">Rewards store</div>
          <span class="small-text">Redeem points for privileges</span>
        </div>

        <div class="form-inline-row">
          <input
            type="text"
            id="newRewardName"
            placeholder="Reward (e.g., Movie night)"
          />
          <input
            type="number"
            id="newRewardCost"
            placeholder="Cost"
            min="1"
            style="max-width: 90px"
          />
          <button class="btn-secondary btn" id="addRewardBtn">
            <span>＋</span> Add reward
          </button>
        </div>

        <ul class="list" id="rewardList"></ul>

        <div class="panel-header" style="margin-top: 14px">
          <div class="panel-title">Activity log</div>
          <div style="display:flex; gap:8px; align-items:center;">
            <button class="btn-secondary btn" id="switchUserBtn">Switch user</button>
          </div>
        </div>

        <div class="history" id="historyContainer"></div>
      </section>
    </div>

    <p class="footer">
      Data is stored as a JSON file in your OneDrive App folder for this shared family account.
      To change who is using it, use “Switch user” and pick Adult, Connor, Jonathan, or Jason.
    </p>
  </div>

  <script>
    /***********************
     *  CONFIG
     ***********************/
    const MSAL_CONFIG = {
      auth: {
        clientId: "YOUR_CLIENT_ID_HERE", // <-- replace with your Azure app's client ID
        authority: "https://login.microsoftonline.com/common",
        redirectUri: "https://placeholder-domain.com/auth/callback" // <-- replace when you host
      },
      cache: {
        cacheLocation: "localStorage",
        storeAuthStateInCookie: false
      }
    };

    const GRAPH_SCOPES = ["User.Read", "Files.ReadWrite.AppFolder", "offline_access"];
    const DATA_FILE_PATH = "/Apps/FamilyChoreSystem/family-data.json";

    const ROLES = [
      { id: "adult", name: "Adult", role: "admin" },
      { id: "connor", name: "Connor", role: "kid" },
      { id: "jonathan", name: "Jonathan", role: "kid" },
      { id: "jason", name: "Jason", role: "kid" }
    ];

    const defaultState = {
      members: [
        { id: "connor", name: "Connor", points: 0 },
        { id: "jonathan", name: "Jonathan", points: 0 },
        { id: "jason", name: "Jason", points: 0 }
      ],
      chores: [
        { id: "c1", name: "Make bed", points: 5 },
        { id: "c2", name: "Dishes", points: 10 },
        { id: "c3", name: "Laundry", points: 15 }
      ],
      rewards: [
        { id: "r1", name: "Extra 15 min screen time", cost: 30 },
        { id: "r2", name: "Choose dinner", cost: 50 },
        { id: "r3", name: "Movie night", cost: 120 }
      ],
      history: []
    };

    let msalInstance = new msal.PublicClientApplication(MSAL_CONFIG);
    let msAccount = null;
    let accessToken = null;
    let state = null;
    let currentRole = null; // one of ROLES

    /***********************
     *  MS LOGIN + GRAPH
     ***********************/
    async function loginWithMicrosoft() {
      try {
        const loginResult = await msalInstance.loginPopup({
          scopes: GRAPH_SCOPES
        });
        msAccount = loginResult.account;
        msalInstance.setActiveAccount(msAccount);
        document.getElementById("loginError").textContent = "";
        await acquireToken();
        await loadStateFromOneDrive();
        renderMsUserInfo();
        renderRoles();
      } catch (e) {
        console.error(e);
        document.getElementById("loginError").textContent =
          "Microsoft login failed. Check console for details.";
      }
    }

    async function acquireToken() {
      const activeAccount = msalInstance.getActiveAccount();
      if (!activeAccount) throw new Error("No active account");

      try {
        const result = await msalInstance.acquireTokenSilent({
          scopes: GRAPH_SCOPES,
          account: activeAccount
        });
        accessToken = result.accessToken;
      } catch (e) {
        const result = await msalInstance.acquireTokenPopup({
          scopes: GRAPH_SCOPES
        });
        accessToken = result.accessToken;
      }
    }

    async function graphRequest(endpoint, options = {}) {
      if (!accessToken) await acquireToken();
      const res = await fetch("https://graph.microsoft.com/v1.0" + endpoint, {
        ...options,
        headers: {
          ...(options.headers || {}),
          Authorization: "Bearer " + accessToken,
          "Content-Type": "application/json"
        }
      });
      if (!res.ok) {
        const text = await res.text();
        throw new Error("Graph error " + res.status + ": " + text);
      }
      if (res.status === 204) return null;
      return res.json();
    }

    async function loadStateFromOneDrive() {
      try {
        // Get file metadata
        const driveItem = await graphRequest(
          `/me/drive/special/approot:/${encodeURIComponent("family-data.json")}`
        );
        // Download content
        const downloadUrl = driveItem["@microsoft.graph.downloadUrl"];
        const res = await fetch(downloadUrl);
        const json = await res.json();
        state = json;
      } catch (e) {
        // If file doesn’t exist, create it
        console.warn("Could not load existing data. Using defaults and creating file.", e);
        state = JSON.parse(JSON.stringify(defaultState));
        await saveStateToOneDrive();
      }
    }

    async function saveStateToOneDrive() {
      if (!accessToken || !state) return;
      const content = JSON.stringify(state, null, 2);
      const res = await fetch(
        "https://graph.microsoft.com/v1.0/me/drive/special/approot:/family-data.json:/content",
        {
          method: "PUT",
          headers: {
            Authorization: "Bearer " + accessToken,
            "Content-Type": "application/json"
          },
          body: content
        }
      );
      if (!res.ok) {
        const text = await res.text();
        console.error("Failed to save to OneDrive", res.status, text);
      }
    }

    /***********************
     *  UI: LOGIN / ROLE
     ***********************/
    const loginOverlay = document.getElementById("loginOverlay");
    const msUserInfo = document.getElementById("msUserInfo");
    const roleList = document.getElementById("roleList");
    const loginError = document.getElementById("loginError");
    const appShell = document.getElementById("appShell");
    const currentUserChip = document.getElementById("currentUserChip");

    function renderMsUserInfo() {
      if (!msAccount) {
        msUserInfo.textContent = "";
        return;
      }
      msUserInfo.textContent = `Signed in as ${msAccount.username}`;
    }

    function renderRoles() {
      roleList.innerHTML = "";
      ROLES.forEach((r) => {
        const li = document.createElement("li");
        li.className = "user-item";
        li.innerHTML = `
          <div>
            <div>${r.name}</div>
            <div class="user-role">${
              r.role === "admin" ? "Adult · Sees all kids" : "Kid · Sees own data"
            }</div>
          </div>
          <div class="small-text">Tap to choose</div>
        `;
        li.onclick = () => chooseRole(r.id);
        roleList.appendChild(li);
      });
    }

    function chooseRole(roleId) {
      if (!msAccount || !state) {
        loginError.textContent = "Sign in with Microsoft first.";
        return;
      }
      currentRole = ROLES.find((r) => r.id === roleId);
      if (!currentRole) return;
      loginOverlay.style.display = "none";
      appShell.style.display = "";
      updateCurrentUserChip();
      render();
    }

    function updateCurrentUserChip() {
      if (!currentRole || !msAccount) return;
      currentUserChip.innerHTML = `
        <span class="current-user-name">${currentRole.name}</span>
        · ${currentRole.role === "admin" ? "Adult (sees all kids)" : "Kid (sees own data)"}
      `;
    }

    document.getElementById("msLoginBtn").addEventListener("click", loginWithMicrosoft);

    document.getElementById("switchUserBtn").addEventListener("click", () => {
      appShell.style.display = "none";
      loginOverlay.style.display = "";
      currentRole = null;
      loginError.textContent = "";
    });

    /***********************
     *  STATE + RENDERING
     ***********************/
    const membersContainer = document.getElementById("membersContainer");
    const choreList = document.getElementById("choreList");
    const rewardList = document.getElementById("rewardList");
    const historyContainer = document.getElementById("historyContainer");
    const totalPointsLabel = document.getElementById("totalPointsLabel");

    function uid(prefix) {
      return prefix + Math.random().toString(36).slice(2, 10);
    }

    function formatDateTime(ts) {
      const d = new Date(ts);
      return (
        d.toLocaleDateString() +
        " · " +
        d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
      );
    }

    function visibleMembers() {
      if (!state || !currentRole) return [];
      if (currentRole.role === "admin") return state.members;
      return state.members.filter((m) => m.id === currentRole.id);
    }

    function render() {
      if (!state || !currentRole) return;
      renderMembers();
      renderChores();
      renderRewards();
      renderHistory();
      renderTotals();
      saveStateToOneDrive(); // fire and forget
    }

    function renderTotals() {
      const total = state.members.reduce((sum, m) => sum + m.points, 0);
      if (currentRole.role === "admin") {
        totalPointsLabel.textContent = "Total points (all kids): " + total;
      } else {
        const me = state.members.find((m) => m.id === currentRole.id);
        totalPointsLabel.textContent = "Your points: " + (me ? me.points : 0);
      }
    }

    function renderMembers() {
      membersContainer.innerHTML = "";
      visibleMembers().forEach((member) => {
        const div = document.createElement("div");
        div.className = "member-card";
        div.innerHTML = `
          <div class="member-top">
            <span class="member-name">${member.name}</span>
            <span class="points-badge">${member.points} pts</span>
          </div>
          <div class="points-large">${member.points}</div>
          <div class="small-text">${
            currentRole.role === "admin"
              ? "Assign chores below to update points."
              : "Chores and rewards below only change your points."
          }</div>
        `;
        membersContainer.appendChild(div);
      });
    }

    function renderChores() {
      choreList.innerHTML = "";
      state.chores.forEach((chore) => {
        const li = document.createElement("li");
        li.className = "list-item";
        const choreId = chore.id;

        const main = document.createElement("div");
        main.className = "list-main";
        main.innerHTML = `
          <span>${chore.name}</span>
          <span class="pill-small">+${chore.points} pts</span>
        `;

        const controls = document.createElement("div");
        controls.style.display = "flex";
        controls.style.gap = "6px";
        controls.style.alignItems = "center";

        const memberSelect = document.createElement("select");

        const availableMembers =
          currentRole.role === "admin"
            ? state.members
            : state.members.filter((m) => m.id === currentRole.id);

        availableMembers.forEach((m) => {
          const opt = document.createElement("option");
          opt.value = m.id;
          opt.textContent = m.name;
          memberSelect.appendChild(opt);
        });

        const assignBtn = document.createElement("button");
        assignBtn.className = "btn";
        assignBtn.textContent = "Assign";
        assignBtn.onclick = () => {
          const memberId = memberSelect.value;
          if (!memberId) return;
          awardPointsForChore(memberId, choreId);
        };

        controls.appendChild(memberSelect);
        controls.appendChild(assignBtn);

        if (currentRole.role === "admin") {
          const deleteBtn = document.createElement("button");
          deleteBtn.className = "btn-secondary btn";
          deleteBtn.textContent = "✕";
          deleteBtn.title = "Remove chore";
          deleteBtn.onclick = () => {
            if (confirm(`Delete chore "${chore.name}"?`)) {
              state.chores = state.chores.filter((c) => c.id !== choreId);
              render();
            }
          };
          controls.appendChild(deleteBtn);
        }

        li.appendChild(main);
        li.appendChild(controls);

        choreList.appendChild(li);
      });

      if (state.chores.length === 0) {
        choreList.innerHTML =
          '<li class="small-text">No chores yet. Add one above.</li>';
      }
    }

    function renderRewards() {
      rewardList.innerHTML = "";
      state.rewards.forEach((reward) => {
        const li = document.createElement("li");
        li.className = "list-item";
        const rewardId = reward.id;

        const main = document.createElement("div");
        main.className = "list-main";
        main.innerHTML = `
          <span>${reward.name}</span>
          <span class="pill-small">${reward.cost} pts</span>
        `;

        const controls = document.createElement("div");
        controls.style.display = "flex";
        controls.style.gap = "6px";
        controls.style.alignItems = "center";

        const memberSelect = document.createElement("select");

        const availableMembers =
          currentRole.role === "admin"
            ? state.members
            : state.members.filter((m) => m.id === currentRole.id);

        availableMembers.forEach((m) => {
          const opt = document.createElement("option");
          opt.value = m.id;
          opt.textContent = m.name;
          memberSelect.appendChild(opt);
        });

        const redeemBtn = document.createElement("button");
        redeemBtn.className = "btn";
        redeemBtn.textContent = "Redeem";
        redeemBtn.onclick = () => {
          const memberId = memberSelect.value;
          if (!memberId) return;
          redeemReward(memberId, rewardId);
        };

        controls.appendChild(memberSelect);
        controls.appendChild(redeemBtn);

        if (currentRole.role === "admin") {
          const deleteBtn = document.createElement("button");
          deleteBtn.className = "btn-secondary btn";
          deleteBtn.textContent = "✕";
          deleteBtn.title = "Remove reward";
          deleteBtn.onclick = () => {
            if (confirm(`Delete reward "${reward.name}"?`)) {
              state.rewards = state.rewards.filter((r) => r.id !== rewardId);
              render();
            }
          };
          controls.appendChild(deleteBtn);
        }

        li.appendChild(main);
        li.appendChild(controls);

        rewardList.appendChild(li);
      });

      if (state.rewards.length === 0) {
        rewardList.innerHTML =
          '<li class="small-text">No rewards yet. Add one above.</li>';
      }
    }

    function renderHistory() {
      historyContainer.innerHTML = "";
      const filteredHistory =
        currentRole.role === "admin"
          ? state.history
          : state.history.filter((h) => h.memberId === currentRole.id);

      if (filteredHistory.length === 0) {
        historyContainer.innerHTML =
          '<div class="small-text">No activity yet. Assign a chore or redeem a reward to get started.</div>';
        return;
      }

      filteredHistory
        .slice()
        .reverse()
        .forEach((entry) => {
          const div = document.createElement("div");
          div.className = "history-entry";

          const left = document.createElement("div");
          const right = document.createElement("div");

          left.innerHTML = `
            <div>
              <span class="tag-member">${entry.memberName}</span>
              ${
                entry.type === "chore"
                  ? `completed <strong>${entry.choreName}</strong>`
                  : `redeemed <strong>${entry.rewardName}</strong>`
              }
            </div>
            <div class="small-text">${formatDateTime(entry.timestamp)}</div>
          `;

          right.innerHTML =
            entry.type === "chore"
              ? `<span class="tag-positive">+${entry.points} pts</span>`
              : `<span class="tag-negative">−${entry.points} pts</span>`;

          div.appendChild(left);
          div.appendChild(right);
          historyContainer.appendChild(div);
        });
    }

    /***********************
     *  LOGIC
     ***********************/
    function awardPointsForChore(memberId, choreId) {
      const member = state.members.find((m) => m.id === memberId);
      const chore = state.chores.find((c) => c.id === choreId);
      if (!member || !chore) return;

      member.points += chore.points;

      state.history.push({
        id: uid("h"),
        type: "chore",
        memberId: member.id,
        memberName: member.name,
        choreId: chore.id,
        choreName: chore.name,
        points: chore.points,
        timestamp: Date.now()
      });

      render();
    }

    function redeemReward(memberId, rewardId) {
      const member = state.members.find((m) => m.id === memberId);
      const reward = state.rewards.find((r) => r.id === rewardId);
      if (!member || !reward) return;

      if (member.points < reward.cost) {
        alert(
          `${member.name} does not have enough points. Needs ${reward.cost}, has ${member.points}.`
        );
        return;
      }

      member.points -= reward.cost;

      state.history.push({
        id: uid("h"),
        type: "reward",
        memberId: member.id,
        memberName: member.name,
        rewardId: reward.id,
        rewardName: reward.name,
        points: reward.cost,
        timestamp: Date.now()
      });

      render();
    }

    /***********************
     *  EVENTS
     ***********************/
    document.getElementById("addChoreBtn").addEventListener("click", () => {
      const nameInput = document.getElementById("newChoreName");
      const pointsInput = document.getElementById("newChorePoints");
      const name = nameInput.value.trim();
      const points = parseInt(pointsInput.value, 10);
      if (!name || isNaN(points) || points <= 0) return;
      state.chores.push({ id: uid("c"), name, points });
      nameInput.value = "";
      pointsInput.value = "";
      render();
    });

    document
      .getElementById("newChoreName")
      .addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          document.getElementById("addChoreBtn").click();
        }
      });

    document
      .getElementById("newChorePoints")
      .addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          document.getElementById("addChoreBtn").click();
        }
      });

    document.getElementById("addRewardBtn").addEventListener("click", () => {
      const nameInput = document.getElementById("newRewardName");
      const costInput = document.getElementById("newRewardCost");
      const name = nameInput.value.trim();
      const cost = parseInt(costInput.value, 10);
      if (!name || isNaN(cost) || cost <= 0) return;
      state.rewards.push({ id: uid("r"), name, cost });
      nameInput.value = "";
      costInput.value = "";
      render();
    });

    document
      .getElementById("newRewardName")
      .addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          document.getElementById("addRewardBtn").click();
        }
      });

    document
      .getElementById("newRewardCost")
      .addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          document.getElementById("addRewardBtn").click();
        }
      });
  </script>
</body>
</html>
